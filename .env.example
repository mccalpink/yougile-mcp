# YouGile MCP Server — шаблон конфигурации
# Скопируйте этот файл в .env и заполните нужные поля

# Базовый URL YouGile API
YOUGILE_BASE_URL=https://yougile.com

# Имя MCP-сервера (отображается в клиентах)
YOUGILE_SERVER_NAME=YouGile MCP Server

# === Режим одной компании (legacy, обратная совместимость) ===
# Используйте если нет нескольких аккаунтов
# YOUGILE_API_KEY=your_api_key_here
# YOUGILE_COMPANY_ID=00000000-0000-0000-0000-000000000000

# === Режим нескольких компаний (multi-tenant) ===
# Slug (часть после YOUGILE_KEY_) используется как параметр workspace= в тулах
YOUGILE_KEY_MAIN=your_primary_company_api_key
YOUGILE_KEY_TEAM=your_team_company_api_key
# YOUGILE_KEY_CLIENT_ACME=client_api_key

# Человекочитаемые названия (отображаются в list_workspaces)
YOUGILE_LABEL_MAIN=Личная компания
YOUGILE_LABEL_TEAM=Команда
# YOUGILE_LABEL_CLIENT_ACME=ACME Corp

# UUID компании (опционально — для /auth/* переинициализации)
# YOUGILE_COMPANY_MAIN=00000000-0000-0000-0000-000000000000

# === Transport ===
# YOUGILE_TRANSPORT=stdio   # по умолчанию (для Claude Desktop / stdio MCP)
# YOUGILE_TRANSPORT=http    # долгоживущий HTTP-процесс (экономия памяти при 5+ сессиях)
# YOUGILE_HOST=127.0.0.1
# YOUGILE_PORT=3000
# YOUGILE_HTTP_PATH=/mcp

# === Integration tests (не для production) ===
# YOUGILE_TEST_API_KEY=key_for_real_api_tests
# YOUGILE_TEST_WORKSPACE=main

# === User memory (SKILL) ===
# Путь к персональному брифингу. По умолчанию: ~/.agents/skills/yougile-personal/
# YOUGILE_USER_MEMORY_DIR=~/.agents/skills/yougile-personal

# === Разработка ===
YOUGILE_DEBUG=false
YOUGILE_TIMEOUT=30
YOUGILE_MAX_RETRIES=3
